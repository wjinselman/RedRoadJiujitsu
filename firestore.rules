rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function developerPath() {
      return /databases/$(database)/documents/developers/$(authEmail());
    }

    function ownerPath() {
      return /databases/$(database)/documents/owners/$(authEmail());
    }

    function kioskPath() {
      return /databases/$(database)/documents/kiosks/$(authEmail());
    }

    function isDeveloper() {
      return signedIn()
        && exists(developerPath())
        && get(developerPath()).data.enabled == true;
    }

    function isOwner() {
      return signedIn()
        && exists(ownerPath())
        && get(ownerPath()).data.enabled == true;
    }

    function isStaff() {
      return isDeveloper() || isOwner();
    }

    function isKiosk() {
      return signedIn()
        && exists(kioskPath())
        && get(kioskPath()).data.enabled == true;
    }

    function validOwner(data, ownerEmail) {
      return data.keys().hasOnly(['email', 'name', 'enabled', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.email.lower() == ownerEmail
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validKiosk(data, kioskEmail) {
      return data.keys().hasOnly(['email', 'name', 'enabled', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.email.lower() == kioskEmail
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCheckInDirectory(data, memberEmail) {
      return data.keys().hasOnly(['memberEmail', 'displayName', 'plan', 'pinHash', 'active', 'updatedAt'])
        && data.memberEmail is string
        && data.memberEmail.lower() == memberEmail
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.plan is string
        && data.plan.size() <= 80
        && data.pinHash is string
        && data.pinHash.size() == 64
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function validAttendance(data) {
      return data.keys().hasOnly([
          'memberEmail', 'memberName', 'className', 'classDate',
          'checkedInAt', 'checkedInBy', 'source'
        ])
        && data.memberEmail is string
        && data.memberEmail == data.memberEmail.lower()
        && data.memberEmail.size() <= 254
        && data.memberName is string
        && data.memberName.size() > 0
        && data.memberName.size() <= 120
        && data.className is string
        && data.className.size() > 0
        && data.className.size() <= 80
        && data.classDate is string
        && data.classDate.size() == 10
        && data.checkedInAt == request.time
        && data.checkedInBy is string
        && data.checkedInBy == authEmail()
        && data.source == 'kiosk';
    }

    function validMember(data, memberEmail) {
      return data.keys().hasOnly([
          'email', 'name', 'rank', 'stripes', 'plan', 'paid', 'active',
          'enabled', 'archived', 'joinedAt', 'waiverSigned', 'waiverSignedAt',
          'waiverReceiptId', 'phone', 'address', 'emergencyName',
          'emergencyPhone', 'guardianName', 'householdEmail',
          'createdAt', 'updatedAt'
        ])
        && data.email is string
        && data.email.lower() == memberEmail
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.rank is string
        && data.rank.size() <= 80
        && data.stripes is int
        && data.stripes >= 0
        && data.stripes <= 4
        && data.plan is string
        && data.plan.size() <= 80
        && data.paid is bool
        && data.active is bool
        && data.enabled is bool
        && data.archived is bool
        && data.joinedAt is string
        && data.joinedAt.size() <= 10
        && data.waiverSigned is bool
        && data.waiverSignedAt is string
        && data.waiverSignedAt.size() <= 40
        && data.waiverReceiptId is string
        && data.waiverReceiptId.size() <= 80
        && data.phone is string
        && data.phone.size() <= 40
        && data.address is string
        && data.address.size() <= 240
        && data.emergencyName is string
        && data.emergencyName.size() <= 160
        && data.emergencyPhone is string
        && data.emergencyPhone.size() <= 40
        && data.guardianName is string
        && data.guardianName.size() <= 160
        && data.householdEmail is string
        && data.householdEmail.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMemberProfileUpdate(data, memberEmail) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'address', 'emergencyName', 'emergencyPhone',
          'guardianName', 'householdEmail', 'updatedAt'
        ])
        && data.email is string
        && data.email.lower() == memberEmail
        && data.phone is string
        && data.phone.size() <= 40
        && data.address is string
        && data.address.size() <= 240
        && data.emergencyName is string
        && data.emergencyName.size() <= 160
        && data.emergencyPhone is string
        && data.emergencyPhone.size() <= 40
        && data.guardianName is string
        && data.guardianName.size() <= 160
        && data.householdEmail is string
        && data.householdEmail.size() <= 254
        && data.updatedAt is timestamp;
    }

    function validSelfSignup(data, memberEmail) {
      return validMember(data, memberEmail)
        && data.rank == 'White Belt'
        && data.stripes == 0
        && data.paid == false
        && data.active == false
        && data.enabled == true
        && data.archived == false
        && data.waiverSigned == true
        && data.waiverSignedAt.size() > 0
        && data.waiverReceiptId.size() > 0;
    }

    function validWaiver(data, waiverEmail) {
      return data.keys().hasOnly([
          'receiptId', 'waiverVersion', 'signedAt', 'participantName', 'dob',
          'email', 'phone', 'address', 'emergencyName', 'emergencyPhone',
          'minor', 'guardianName', 'relationship', 'electronicSignature',
          'signatureDate', 'photoVideoReleaseAccepted', 'photoVideoInitials',
          'signerUid', 'createdAt'
        ])
        && data.email is string
        && data.email.lower() == waiverEmail
        && data.signerUid == request.auth.uid
        && data.receiptId is string
        && data.receiptId.size() > 0
        && data.receiptId.size() <= 80
        && data.participantName is string
        && data.participantName.size() > 0
        && data.participantName.size() <= 160
        && data.electronicSignature is string
        && data.electronicSignature.size() > 0
        && data.electronicSignature.size() <= 160
        && data.minor is bool
        && data.photoVideoReleaseAccepted is bool
        && data.photoVideoInitials is string
        && data.photoVideoInitials.size() <= 12
        && (data.photoVideoReleaseAccepted == false || data.photoVideoInitials.size() > 0)
        && data.createdAt is timestamp;
    }

    function validTrialWaiver(data, trialId) {
      return data.keys().hasOnly([
          'receiptId', 'waiverVersion', 'signedAt', 'participantName', 'dob',
          'email', 'phone', 'address', 'emergencyName', 'emergencyPhone',
          'minor', 'guardianName', 'relationship', 'electronicSignature',
          'signatureDate', 'photoVideoReleaseAccepted', 'photoVideoInitials',
          'trialClass', 'trialProgram', 'trialDate', 'trialExpiresOn', 'status', 'submitterUid',
          'createdAt', 'updatedAt'
        ])
        && data.receiptId == trialId
        && data.receiptId is string
        && data.receiptId.size() > 0
        && data.receiptId.size() <= 80
        && data.waiverVersion is string
        && data.waiverVersion.size() <= 160
        && data.signedAt is string
        && data.signedAt.size() <= 40
        && data.participantName is string
        && data.participantName.size() > 0
        && data.participantName.size() <= 160
        && data.dob is string
        && data.dob.size() <= 10
        && data.email is string
        && data.email == data.email.lower()
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 40
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 240
        && data.emergencyName is string
        && data.emergencyName.size() > 0
        && data.emergencyName.size() <= 160
        && data.emergencyPhone is string
        && data.emergencyPhone.size() > 0
        && data.emergencyPhone.size() <= 40
        && data.minor is bool
        && data.guardianName is string
        && data.guardianName.size() <= 160
        && data.relationship is string
        && data.relationship.size() <= 80
        && data.electronicSignature is string
        && data.electronicSignature.size() > 0
        && data.electronicSignature.size() <= 160
        && data.signatureDate is string
        && data.signatureDate.size() == 10
        && data.photoVideoReleaseAccepted is bool
        && data.photoVideoInitials is string
        && data.photoVideoInitials.size() <= 12
        && (data.photoVideoReleaseAccepted == false || data.photoVideoInitials.size() > 0)
        && data.trialClass == true
        && data.trialProgram is string
        && data.trialProgram.size() > 0
        && data.trialProgram.size() <= 80
        && data.trialDate is string
        && data.trialDate.size() == 10
        && data.trialExpiresOn is string
        && data.trialExpiresOn.size() == 10
        && data.status == 'new'
        && data.submitterUid == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // ROOT ACCESS: developer records are console-managed only.
    // No browser/client code can create, update, list, or delete developer access.
    match /developers/{developerEmail} {
      allow get: if signedIn() && authEmail() == developerEmail;
      allow list, create, update, delete: if false;
    }

    // OWNER ACCESS: each owner can verify only their own access record.
    // Developers can manage the owner list from the Developer dashboard.
    match /owners/{ownerEmail} {
      allow get: if (signedIn() && authEmail() == ownerEmail) || isDeveloper();
      allow list: if isDeveloper()
                  && request.query.limit != null
                  && request.query.limit <= 50;
      allow create, update: if isDeveloper()
                            && validOwner(request.resource.data, ownerEmail);
      allow delete: if false;
    }

    // Dedicated check-in devices are approved by the Developer, then activated
    // once on the iPad. Kiosk accounts are not owners and cannot read members.
    match /kiosks/{kioskEmail} {
      allow get: if (signedIn() && authEmail() == kioskEmail) || isDeveloper();
      allow list: if isDeveloper()
                  && request.query.limit != null
                  && request.query.limit <= 50;
      allow create, update: if isDeveloper()
                            && validKiosk(request.resource.data, kioskEmail);
      allow delete: if false;
    }

    // Member document ID = lowercase member email.
    match /members/{memberEmail} {
      allow get: if (signedIn()
                    && authEmail() == memberEmail
                    && request.auth.token.email_verified == true
                    && resource.data.enabled == true
                    && resource.data.archived != true) || isStaff();
      allow list: if isStaff()
                  && request.query.limit != null
                  && request.query.limit <= 250;
      // Developers have full roster control. Owners retain schema-validated control.
      allow create: if isDeveloper()
                    || (isOwner() && validMember(request.resource.data, memberEmail))
                    || (signedIn()
                        && authEmail() == memberEmail
                        && validSelfSignup(request.resource.data, memberEmail));
      allow update: if isDeveloper()
                    || (isOwner() && validMember(request.resource.data, memberEmail))
                    || (signedIn()
                        && request.auth.token.email_verified == true
                        && authEmail() == memberEmail
                        && resource.data.enabled == true
                        && resource.data.archived != true
                        && validMemberProfileUpdate(request.resource.data, memberEmail));
      // Staff-only permanent roster removal. Authentication identities are managed separately.
      allow delete: if isStaff();
    }

    // Full signed records are append-only from the member flow. Members may read
    // their own record; staff can review it. Client updates and deletes are denied.
    match /waivers/{waiverEmail} {
      allow get: if (signedIn() && authEmail() == waiverEmail) || isStaff();
      allow list: if isStaff()
                  && request.query.limit != null
                  && request.query.limit <= 250;
      allow create: if signedIn()
                    && authEmail() == waiverEmail
                    && !exists(/databases/$(database)/documents/waivers/$(waiverEmail))
                    && validWaiver(request.resource.data, waiverEmail);
      allow update, delete: if false;
    }

    // Free-trial visitors authenticate anonymously for one append-only write.
    // They receive no read access and no member account/document is created.
    match /trialWaivers/{trialId} {
      allow get: if isStaff();
      allow list: if isStaff()
                  && request.query.limit != null
                  && request.query.limit <= 250;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/trialWaivers/$(trialId))
                    && validTrialWaiver(request.resource.data, trialId);
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['new', 'contacted', 'completed']
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isStaff();
    }

    // A deliberately limited directory for the front-desk iPad. It contains
    // only the fields needed to find a member and verify the four-digit PIN.
    match /checkInDirectory/{memberEmail} {
      allow get: if isStaff() || isKiosk();
      allow list: if (isStaff() || isKiosk())
                  && request.query.limit != null
                  && request.query.limit <= 250;
      allow create, update: if isStaff()
                            && validCheckInDirectory(request.resource.data, memberEmail);
      allow delete: if isStaff();
    }

    // One deterministic document per member/class/date prevents accidental
    // duplicate check-ins. Members can only query their own recent history.
    match /attendance/{attendanceId} {
      allow get: if isStaff()
                 || (signedIn() && resource.data.memberEmail == authEmail());
      allow list: if (isStaff()
                      && request.query.limit != null
                      && request.query.limit <= 500)
                  || (signedIn()
                      && resource.data.memberEmail == authEmail()
                      && request.query.limit != null
                      && request.query.limit <= 50);
      allow create: if isKiosk()
                    && validAttendance(request.resource.data)
                    && exists(/databases/$(database)/documents/checkInDirectory/$(request.resource.data.memberEmail))
                    && get(/databases/$(database)/documents/checkInDirectory/$(request.resource.data.memberEmail)).data.active == true
                    && !exists(/databases/$(database)/documents/attendance/$(attendanceId));
      allow update: if false;
      allow delete: if isStaff();
    }

    // Explicit deny-by-default for anything not listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
